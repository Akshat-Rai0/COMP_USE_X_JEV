# ──────────────────────────────────────────────────────────────────
# Reflex Arc Environment Configuration
# ──────────────────────────────────────────────────────────────────

# Decision Backend: "kev" (local), "jev" (remote TypeSafe API), or "llm" (OpenRouter adapter)
DECISION_BACKEND=kev

# ─── Local kev Backend (Default) ───
KEV_BASE_URL=http://localhost:8009
KEV_MODEL=kev-0.5b

# ─── Remote Jev Backend (TypeSafe) ───
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL_VERSION=jev-latest

# ─── Planner & Cortex LLM (OpenRouter) ───
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PLANNER_MODEL=openai/gpt-4o-mini

# ─── Gating & Safety Thresholds ───
CONFIDENCE_GATE=0.70
MIN_GAP=0.15
MAX_STEPS=40
MAX_TIME_SECONDS=120

# ─── Paths & Persistence ───
TRACE_DB_PATH=./runs/traces.sqlite
SCREENSHOT_DIR=./runs

# ─── Screen Recording Configuration ───
RECORD_SCREEN=true
CREATE_GIF=true
MAX_RECORDINGS=10
CAPTURE_IDLE=false
